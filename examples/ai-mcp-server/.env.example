# Auth0 tenant domain, without scheme.
AUTH0_DOMAIN=

# Identifier of the API that represents this server. Access tokens sent to the server must be
# issued for it. Also published as the resource in the protected resource metadata.
MCP_SERVER_URL=

# Application that performs the on-behalf-of token exchange.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Scopes every request to the MCP server must carry (space separated). Optional.
MCP_REQUIRED_SCOPES=

# Scope a caller needs to use the "admin_summary" tool.
MCP_ADMIN_SCOPE=

# Downstream API: identifier (audience), base URL, scope requested for it, scope it requires.
DOWNSTREAM_AUDIENCE=
# Local example: http://localhost:3002/reports
DOWNSTREAM_URL=
DOWNSTREAM_SCOPE=
DOWNSTREAM_REQUIRED_SCOPE=
# Longest wait for the downstream API, in milliseconds. Optional, defaults to 5000.
DOWNSTREAM_TIMEOUT_MS=

# Listen ports. Optional, default to 3001 and 3002.
# MCP_PORT=3001
# DOWNSTREAM_PORT=3002

# Only for "npm run smoke:real". The smoke test signs a test user in with the Resource Owner
# Password grant. That grant is for local testing only.
# Client that may use the password grant, and its secret if it is confidential.
SMOKE_LOGIN_CLIENT_ID=
SMOKE_LOGIN_CLIENT_SECRET=
# Test user credentials.
SMOKE_USERNAME=
SMOKE_PASSWORD=
# Database connection name. When set, the password-realm grant is used. Optional.
SMOKE_REALM=
# Scope requested for the user token. Optional, defaults to openid.
SMOKE_SCOPE=
