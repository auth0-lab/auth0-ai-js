# Auth0 tenant domain, without scheme.
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Public URL of this server. It is also the identifier of the API that represents
# it: access tokens sent to the server must be issued for it.
MCP_SERVER_URL=http://localhost:3001/mcp

# Application that performs the on-behalf-of token exchange.
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# Scopes every request to the MCP server must carry (space separated). Optional.
MCP_REQUIRED_SCOPES=

# Scope a caller needs to use the "admin_summary" tool.
MCP_ADMIN_SCOPE=read:admin

# Downstream API: identifier (audience), base URL, scope requested for it, listen port.
DOWNSTREAM_AUDIENCE=https://reports.example.com
DOWNSTREAM_URL=http://localhost:3002
DOWNSTREAM_SCOPE=read:reports
DOWNSTREAM_REQUIRED_SCOPE=read:reports
# Longest wait for the downstream API, in milliseconds. Optional, defaults to 5000.
DOWNSTREAM_TIMEOUT_MS=5000

# Listen ports.
MCP_PORT=3001
DOWNSTREAM_PORT=3002
